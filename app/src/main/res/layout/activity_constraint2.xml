<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F0F0">

    <ImageView
        android:id="@+id/iv_station"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:src="@drawable/space_station_icon"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/iv_flight" />

    <TextView
        android:id="@+id/tv_station"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Space Stations"
        android:textSize="12sp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/iv_station"
        app:layout_constraintStart_toStartOf="@id/iv_station"
        app:layout_constraintEnd_toEndOf="@id/iv_station" />

    <ImageView
        android:id="@+id/iv_flight"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:src="@drawable/rocket_icon"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_station"
        app:layout_constraintEnd_toStartOf="@id/iv_rover" />

    <TextView
        android:id="@+id/tv_flight"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Flights"
        android:textSize="12sp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/iv_flight"
        app:layout_constraintStart_toStartOf="@id/iv_flight"
        app:layout_constraintEnd_toEndOf="@id/iv_flight" />

    <ImageView
        android:id="@+id/iv_rover"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:src="@drawable/rover_icon"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_flight"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_rover"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Rovers"
        android:textSize="12sp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/iv_rover"
        app:layout_constraintStart_toStartOf="@id/iv_rover"
        app:layout_constraintEnd_toEndOf="@id/iv_rover" />

    <TextView
        android:id="@+id/tv_dca"
        android:layout_width="130dp"
        android:layout_height="100dp"
        android:background="#2E7D32"
        android:text="DCA"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tv_station"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="60dp"/>

    <TextView
        android:id="@+id/tv_mars"
        android:layout_width="130dp"
        android:layout_height="100dp"
        android:background="#2E7D32"
        android:text="MARS"
        android:textColor="#FFFFFF"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@id/tv_dca"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="60dp"/>

    <ImageView
        android:id="@+id/iv_arrows"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/double_arrows"
        app:layout_constraintStart_toEndOf="@id/tv_dca"
        app:layout_constraintEnd_toStartOf="@id/tv_mars"
        app:layout_constraintTop_toTopOf="@id/tv_dca"
        app:layout_constraintBottom_toBottomOf="@id/tv_dca"/>

    <TextView
        android:id="@+id/tv_one_way"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:paddingStart="16dp"
        android:paddingEnd="40dp"
        android:background="#FF9800"
        android:text="One Way"
        android:textColor="#FFFFFF"
        android:gravity="center_vertical"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tv_dca"
        app:layout_constraintStart_toStartOf="@id/tv_dca" />

    <androidx.cardview.widget.CardView
        android:id="@+id/v_dot"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:cardCornerRadius="8dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardElevation="0dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toTopOf="@id/tv_one_way"
        app:layout_constraintBottom_toBottomOf="@id/tv_one_way"
        app:layout_constraintEnd_toEndOf="@id/tv_one_way" />

    <TextView
        android:id="@+id/tv_traveller"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#FF9800"
        android:text="1 Traveller"
        android:textColor="#FFFFFF"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_one_way"
        app:layout_constraintStart_toStartOf="@id/tv_one_way" />

    <ImageView
        android:id="@+id/iv_rocket"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/rocket_icon"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toTopOf="@id/iv_galaxy"
        app:layout_constraintBottom_toBottomOf="@id/iv_galaxy"
        app:layout_constraintEnd_toStartOf="@id/iv_galaxy" />

    <ImageView
        android:id="@+id/iv_galaxy"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/galaxy"
        app:layout_constraintTop_toBottomOf="@id/tv_traveller"
        app:layout_constraintBottom_toTopOf="@id/btn_depart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/btn_depart"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:background="#2E7D32"
        android:text="DEPART"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>